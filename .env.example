# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Generate independent random values; never commit real values
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Optional tunable estimates (not direct measurements)
DATABASE_PATH=
API_PORT=3001
CLOUD_KWH_PER_GB_MONTH=0.02
GRID_KG_PER_KWH=0.475
AI_KWH_PER_QUERY=0.002
AI_KWH_PER_HOUR=0.04
TRANSFER_KWH_PER_GB=0.03
COMPUTE_KWH_PER_HOUR=0.05
